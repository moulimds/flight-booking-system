{
  "info": {
    "name": "Flight Tracking Service API Collection",
    "description": "Complete Postman collection for testing Standalone Flight Tracking Microservice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Direct Flight (Chennai -> Delhi)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightNumber\": \"AI202\",\n  \"legs\": [\n    {\n      \"legNumber\": 1,\n      \"source\": \"Chennai\",\n      \"destination\": \"Delhi\",\n      \"scheduledDepartureTime\": \"2026-09-18T10:00:00\",\n      \"scheduledArrivalTime\": \"2026-09-18T13:00:00\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:8086/api/flights",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8086",
          "path": ["api", "flights"]
        }
      }
    },
